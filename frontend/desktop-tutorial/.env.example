# FasalSathi backend — copy to `.env` (same folder) and fill in what you need.
# `.env` is git-ignored. NEVER commit real keys. The app runs without keys
# (mandi + chatbot fall back to clearly-labelled local estimates/offline mode).

# --- KisanMitra chatbot (provide ANY ONE; default provider is Gemini) ---
# Get a free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Get a free key: https://console.groq.com/keys
GROQ_API_KEY=
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Which provider to use: gemini | groq | openrouter
KISANMITRA_PROVIDER=gemini

# --- Live mandi prices (data.gov.in, free signup) ---
# https://www.data.gov.in/  -> "Current Daily Price of Various Commodities"
MANDI_API_KEY=
MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# --- Optional ---
# OPENWEATHER_API_KEY=
# SERVER_PORT=8080
